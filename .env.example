# === LLM Configuration ===
# Get your free API key at https://aistudio.google.com/apikey
# Optional: The agent works without it and will run using the local embedding pipeline
GOOGLE_API_KEY=your_api_key_here

# === Database Configuration ===
# For local development, use SQLite. For production, use PostgreSQL
# SQLite: sqlite:///recruiting_agent.db
# PostgreSQL: postgresql://user:password@localhost:5432/recruiting_agent
DATABASE_URL=sqlite:///recruiting_agent.db

# === Flask Configuration ===
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_change_in_production

# === Server Configuration ===
HOST=127.0.0.1
PORT=5000

# === File Upload Configuration ===
# Maximum file size in MB for resume uploads
MAX_RESUME_SIZE_MB=10
# Maximum file size in MB for JD uploads
MAX_JD_SIZE_MB=5
# Allowed resume file extensions (comma-separated)
ALLOWED_RESUME_EXTENSIONS=.txt,.pdf,.docx

# === Email Configuration (Optional, for future notifications) ===
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# NOTIFICATION_EMAIL=admin@company.com
