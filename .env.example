# Copy to .env and edit. Every setting is optional; .env is gitignored.

# === LLM (optional) ===
# Free key: https://aistudio.google.com/apikey
# SYNTHETIC DATA ONLY: on Gemini's free tier, content is used to improve Google's products.
# Never set this while processing real candidates' resumes. The app works fully without it.
GOOGLE_API_KEY=your_api_key_here
# Gemini model name. Change it if Google retires the model or your key's free tier lacks it.
GEMINI_MODEL=gemini-3.8-flash

# === Database ===
# SQLite by default. For PostgreSQL + pgvector (see README "Database setup"):
# DATABASE_URL=postgresql+psycopg://hireai:hireai@127.0.0.1:5433/hireai
DATABASE_URL=sqlite:///recruiting_agent.db

# === Retrieval embeddings (never affect scores) ===
# sentence-transformers (local, offline) or gemini (synthetic data only).
# After changing these, rebuild stored vectors: python -m indexing --reindex
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_API_MODEL=gemini-embedding-001
EMBEDDING_API_DIM=768

# === Server (used by `python app.py`) ===
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=False

# === Uploads ===
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=.txt,.pdf,.docx

# Send retrieved resume excerpts to Gemini for "Ask the candidate pool" (synthetic data only)
ASK_LLM_ENABLED=false
